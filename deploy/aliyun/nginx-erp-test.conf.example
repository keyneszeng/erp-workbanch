# 测试环境 Nginx 模板：纯 HTTP、非标准端口 8080。
#
# 为什么不用 80/443：域名未完成 ICP 备案，阿里云会拦截内地 ECS 的 80/443，
# 用 8080 可以绕过备案前置条件，先做真实环境验证。备案通过后再切生产配置。
#
# server_name 用 _ 兜底，允许直接用 IP 访问。
server {
    listen 8080;
    listen [::]:8080;
    server_name _;

    # 落库上限 20MB（storage.js MAX_BYTES），但允许上传 200MB 的原始扫描件，
    # 由服务端压缩到 20MB 内再入库。这里按压缩前上限 + 头部余量放行，
    # 设小了会在 nginx 层直接 413，应用层根本没机会给出友好提示。
    client_max_body_size 210m;
    # 200MB 在慢速网络上要传几分钟，压缩 100MB 的 PDF 也可能跑一分钟以上
    client_body_timeout 300s;
    send_timeout 300s;

    location / {
        proxy_pass http://127.0.0.1:8788;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_read_timeout 300s;
    }
}
