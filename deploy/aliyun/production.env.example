# Server-only template: copy to /etc/erp-workbanch/production.env and chmod 600
# NEVER commit a populated production.env to GitHub.
NODE_ENV=production
ERP_DEPLOY_TARGET=aliyun-ecs
ERP_DEMO_MODE=0
ERP_PRODUCTION_DOMAIN=production.example.com
# 邀请函公开链接前缀（邮件/二维码里的地址）。生产填 https://域名，测试填 http://IP:8080。
ERP_PUBLIC_BASE_URL=
ERP_BOOTSTRAP_ADMIN_PHONE=
ERP_DB=/var/lib/erp/erp.db
ERP_UPLOAD_DIR=/var/lib/erp/uploads
# Office 原件转 PDF 的缓存目录（在线预览用，可随时清空，会自动重建）
ERP_PREVIEW_CACHE_DIR=/var/lib/erp/preview-cache
ERP_HOST=127.0.0.1
ERP_PORT=8787
ERP_TRUST_PROXY=1
ERP_SESSION_FALLBACK=0
ERP_SECRET=

# 劳务收款人银行账号加密密钥（64 位十六进制 = 32 字节）。
# 不可与数据库一起备份到公开位置；轮换前必须先迁移已加密数据。
# 启用 ERP_REQUIRE_VERIFIED_PAYEES=1 前必须先补齐历史收款人记录。
ERP_FINANCIAL_DATA_KEY=
ERP_REQUIRE_VERIFIED_PAYEES=0

# 邀请函邮件（Resend）发件密钥的加密口令，至少 32 字符。
# 缺失时管理员无法在界面保存 Resend API Key，邀请函只能生成 PDF、发不出邮件。
ERP_MAIL_CONFIG_KEY=

# 材料/议程离线 OCR：需先装 tesseract-ocr + chi_sim/eng 语言包 + poppler-utils。
# 开启后服务启动预检会逐个校验这些二进制与语言模型。
ERP_OCR_ENABLED=0

# 短信验证码通道：aliyun（推荐，与 ECS 同云）或 tencent（保留兼容）。
# 只填所选 provider 对应的四项/五项，另一组留空或注释掉。
ERP_SMS_PROVIDER=aliyun
ERP_ALIYUN_SMS_ACCESS_KEY_ID=
ERP_ALIYUN_SMS_ACCESS_KEY_SECRET=
ERP_ALIYUN_SMS_SIGN_NAME=
ERP_ALIYUN_SMS_TEMPLATE_CODE=
ERP_ALIYUN_SMS_REGION=cn-hangzhou

# ERP_TENCENT_SECRET_ID=
# ERP_TENCENT_SECRET_KEY=
# ERP_TENCENT_SMS_APP_ID=
# ERP_TENCENT_SMS_SIGN=
# ERP_TENCENT_SMS_TEMPLATE_ID=
# ERP_TENCENT_SMS_REGION=ap-guangzhou

# WeChat Mini Program is OFF until an audited real AppID/secret and request domain are ready.
ERP_MINIPROGRAM_ENABLED=0
ERP_WECHAT_APP_ID=
ERP_WECHAT_APP_SECRET=
