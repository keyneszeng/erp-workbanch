# 云服务器测试环境模板：复制到 /etc/erp-workbanch/test.env 后 chmod 600
# 与生产 production.env 完全独立，绝不共用数据库、端口和密钥。
# NEVER commit a populated test.env to GitHub.
NODE_ENV=production
ERP_DEPLOY_TARGET=aliyun-ecs-test
ERP_DEMO_MODE=0
# 域名未备案阶段留空，直接用 http://<ECS公网IP>:8080 访问
ERP_PRODUCTION_DOMAIN=
# 邀请函公开链接前缀（邮件/二维码里的地址）。生产填 https://域名，测试填 http://IP:8080。
ERP_PUBLIC_BASE_URL=
ERP_BOOTSTRAP_ADMIN_PHONE=
ERP_DB=/var/lib/erp-test/erp.db
ERP_UPLOAD_DIR=/var/lib/erp-test/uploads
# Office 原件转 PDF 的缓存目录（在线预览用，可随时清空，会自动重建）
ERP_PREVIEW_CACHE_DIR=/var/lib/erp-test/preview-cache
# 单份附件的落库上限（MB）；超过的会在上传时自动压缩到该值以内
ERP_MAX_FILE_MB=50
# 压缩前允许上传的原始大小上限（MB）
ERP_MAX_UPLOAD_MB=200
ERP_HOST=127.0.0.1
ERP_PORT=8788
ERP_TRUST_PROXY=1
ERP_SESSION_FALLBACK=0
ERP_SECRET=
# 劳务收款人银行账号加密密钥（64 位十六进制 = 32 字节）。缺失时敏感账号不写库。
ERP_FINANCIAL_DATA_KEY=
# 邀请函邮件（Resend）发件密钥的加密口令，至少 32 字符。缺失时只能生成 PDF，发不出邮件。
ERP_MAIL_CONFIG_KEY=

# 材料/议程离线 OCR：服务器已装 tesseract + chi_sim/eng + poppler，测试环境默认开启。
ERP_OCR_ENABLED=1
ERP_REQUIRE_VERIFIED_PAYEES=0

# 测试阶段短信签名/模板未审核，验证码不真实发送：
#   console 通道把验证码写进 journalctl -u erp-test 的日志
ERP_SMS_PROVIDER=console
# 可选：设成 6 位数字后，验证码固定为该值，方便多人同时验收（仅 console 通道生效）
ERP_TEST_FIXED_SMS_CODE=

# 短信审核通过后，把上面两行换成阿里云配置即可（代码无需改动）：
# ERP_SMS_PROVIDER=aliyun
# ERP_ALIYUN_SMS_ACCESS_KEY_ID=
# ERP_ALIYUN_SMS_ACCESS_KEY_SECRET=
# ERP_ALIYUN_SMS_SIGN_NAME=
# ERP_ALIYUN_SMS_TEMPLATE_CODE=
# ERP_ALIYUN_SMS_REGION=cn-hangzhou

ERP_MINIPROGRAM_ENABLED=0
ERP_WECHAT_APP_ID=
ERP_WECHAT_APP_SECRET=
