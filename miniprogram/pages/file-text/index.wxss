.wrap { padding: 24rpx; }
.hd { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-bottom: 20rpx; }
.title { font-size: 30rpx; font-weight: 600; word-break: break-all; }
.hint { color: #8a94a6; font-size: 26rpx; padding: 24rpx 0; }
.err { color: #d4380d; }
.content {
  background: #f7f9fc; border: 1rpx solid #e3e8f0; border-radius: 12rpx;
  padding: 24rpx; font-size: 26rpx; line-height: 1.7; color: #1f2937;
  white-space: pre-wrap; word-break: break-all;
}
