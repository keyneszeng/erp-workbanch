<view class="wrap">
  <view class="card card-accent">
    <view class="row">
      <view>
        <view class="page-kicker">INTERNAL APPLICATION</view>
        <view class="heading">内部立项申请</view>
      </view>
      <view class="status-pill {{status==='草稿'?'status-muted':'status-warning'}}">{{status}}</view>
    </view>
    <view class="notice">
      <text class="notice-icon">i</text>
      <text>填写会议信息并保存草稿，确认无误后提交协会管理员审批。提交后不可直接修改。</text>
    </view>
    <view wx:if="{{status!=='草稿'}}" class="error"><text class="feedback-icon">!</text><text>当前申请已进入“{{status}}”阶段，仅草稿可以编辑。</text></view>
  </view>

  <view class="form-section">
    <view class="section-head">
      <view class="row"><view class="section-index">01</view><view class="section-caption">会议基本信息</view></view>
      <view class="micro">带 * 为必填</view>
    </view>

    <view class="field">
      <view class="field-label"><text class="required">*</text>会议名称</view>
      <input class="field-control" value="{{name}}" data-key="name" bindinput="input" placeholder="请输入会议名称" disabled="{{status!=='草稿'}}"/>
    </view>
    <view class="field">
      <view class="field-label"><text class="required">*</text>所属协会</view>
      <picker wx:if="{{isAdmin}}" mode="selector" range="{{assocs}}" value="{{assocIndex}}" bindchange="pickAssoc" disabled="{{status!=='草稿'}}">
        <view class="picker-control"><text class="picker-value">{{assoc||'请选择协会'}}</text><text class="picker-arrow">⌄</text></view>
      </picker>
      <view wx:else class="field-readonly">{{assoc||'未配置所属协会，请联系管理员'}}</view>
    </view>
    <view class="field">
      <view class="field-label"><text class="required">*</text>会议形式</view>
      <picker range="{{forms}}" value="{{formIndex}}" bindchange="pickForm" disabled="{{status!=='草稿'}}">
        <view class="picker-control"><text class="picker-value">{{form}}</text><text class="picker-arrow">⌄</text></view>
      </picker>
    </view>
    <view class="field">
      <view class="field-label"><text class="required">*</text>会议日期</view>
      <picker mode="date" value="{{date}}" bindchange="pickDate" disabled="{{status!=='草稿'}}">
        <view class="picker-control"><text class="picker-value">{{date||'选择日期'}}</text><text class="picker-arrow">⌄</text></view>
      </picker>
    </view>
    <view class="field">
      <view class="field-label">会期</view>
      <input class="field-control" type="number" value="{{days}}" data-key="days" bindinput="input" placeholder="请输入天数" disabled="{{status!=='草稿'}}"/>
      <view class="field-hint">按自然日填写，默认 1 天</view>
    </view>
  </view>

  <view class="form-section">
    <view class="section-head">
      <view class="row"><view class="section-index">02</view><view class="section-caption">预算与执行信息</view></view>
    </view>
    <view class="field">
      <view class="field-label"><text class="required">*</text>预计预算（元）</view>
      <input class="field-control" type="digit" value="{{budget}}" data-key="budget" bindinput="input" placeholder="请输入预算金额" disabled="{{status!=='草稿'}}"/>
    </view>
    <view class="field">
      <view class="field-label">预计参会人数</view>
      <input class="field-control" type="number" value="{{people}}" data-key="people" bindinput="input" placeholder="例如 200" disabled="{{status!=='草稿'}}"/>
    </view>
    <view class="field">
      <view class="field-label">联系人电话</view>
      <input class="field-control" type="text" maxlength="20" value="{{phone}}" data-key="phone" bindinput="input" placeholder="请输入联系电话" disabled="{{status!=='草稿'}}"/>
    </view>
    <view class="field">
      <view class="field-label"><text class="required">*</text>承办部门</view>
      <picker mode="selector" range="{{depts}}" value="{{deptIndex}}" bindchange="pickDept" disabled="{{status!=='草稿'}}">
        <view class="picker-control"><text class="picker-value">{{dept||(deptLegacy?'历史部门待重新分类':'请选择承办部门')}}</text><text class="picker-arrow">⌄</text></view>
      </picker>
    </view>
    <view class="field">
      <view class="field-label"><text class="required">*</text>初版议程</view>
      <textarea class="textarea-control" value="{{agenda}}" data-key="agenda" bindinput="input" placeholder="例如：09:00 开场；09:30 专题演讲" maxlength="2000" disabled="{{status!=='草稿'}}"/>
      <view class="field-hint">可填写主要环节、时间安排与拟邀嘉宾</view>
    </view>
  </view>

  <view wx:if="{{error}}" class="error"><text class="feedback-icon">!</text><text>{{error}}</text></view>
  <view wx:if="{{status==='草稿'}}" class="form-actions">
    <button class="btn ghost" loading="{{busy}}" disabled="{{busy}}" data-submit="no" bindtap="save">保存草稿</button>
    <button class="btn primary" loading="{{busy}}" disabled="{{busy}}" data-submit="yes" bindtap="save">提交审批</button>
  </view>
</view>
