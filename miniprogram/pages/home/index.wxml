<view class="wrap">
  <view class="home-hero">
    <view class="hero-content">
      <view class="hero-brand">
        <view class="hero-brand-mark">会</view>
        <view class="hero-eyebrow">移动协同工作台</view>
      </view>
      <view class="hero-heading">{{user ? user.name + '，您好' : '会务协同，一站完成'}}</view>
      <view class="hero-sub">项目申请、会议执行、材料留痕与审批核销，共用同一套 ERP 权限。</view>
      <view wx:if="{{user}}" class="hero-user">
        <view class="hero-avatar">{{userInitial}}</view>
        <view>
          <view class="hero-user-name">{{user.name}}</view>
          <view class="hero-user-role">{{role||'已授权用户'}} · 数据按角色范围展示</view>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{loading}}" class="card loading-state"><view class="spinner"></view><text>正在同步工作台数据</text></view>
  <view wx:if="{{error}}" class="error"><text class="feedback-icon">!</text><text>{{error}}</text></view>

  <view wx:if="{{!loading && stats.length}}" class="card">
    <view class="section-head">
      <view>
        <view class="page-kicker">TODAY</view>
        <view class="section-caption">业务概览</view>
      </view>
      <view class="micro">实时权限口径</view>
    </view>
    <view class="metric-strip">
      <view wx:for="{{stats}}" wx:key="label" class="metric">
        <view class="metric-num">{{item.value}}</view>
        <view class="metric-label">{{item.label}}</view>
      </view>
    </view>
  </view>

  <view wx:if="{{!loading}}" class="section-head space-sm">
    <view>
      <view class="page-kicker">QUICK ACCESS</view>
      <view class="section-caption">常用功能</view>
    </view>
  </view>
  <view wx:if="{{!loading}}" class="quick-grid">
    <view wx:if="{{canApply}}" class="quick-tile quick-blue" data-page="apply" bindtap="go">
      <view class="quick-icon">立</view><view class="quick-title">内部立项</view><view class="quick-sub">新建会议申请</view>
    </view>
    <view wx:if="{{canApply}}" class="quick-tile quick-green" bindtap="myApplications">
      <view class="quick-icon">申</view><view class="quick-title">我的申请</view><view class="quick-sub">草稿与审批进度</view>
    </view>
    <view wx:if="{{canMeetings}}" class="quick-tile quick-orange" bindtap="meetingList">
      <view class="quick-icon">会</view><view class="quick-title">我的会议</view><view class="quick-sub">项目详情与进度</view>
    </view>
    <view wx:if="{{canApprove}}" class="quick-tile quick-purple" data-page="approvals" bindtap="go">
      <view class="quick-icon">批</view><view class="quick-title">待我审批</view><view class="quick-sub">处理授权审批单</view>
    </view>
    <view wx:if="{{canMaterials}}" class="quick-tile quick-steel" data-page="materials" bindtap="go">
      <view class="quick-icon">材</view><view class="quick-title">材料收集</view><view class="quick-sub">拍照上传并归档</view>
    </view>
    <view class="quick-tile quick-light" data-page="account" bindtap="go">
      <view class="quick-icon">安</view><view class="quick-title">账户安全</view><view class="quick-sub">身份验证与退出</view>
    </view>
  </view>

  <view wx:if="{{!loading}}" class="card space-sm entry-card" bindtap="publicApply">
    <view class="entry-icon public">公众</view>
    <view class="grow">
      <view class="entry-title">社会公众活动申请</view>
      <view class="entry-sub">免登录提交意向，不进入内部立项审批</view>
    </view>
    <view class="chevron">›</view>
  </view>

  <view wx:if="{{!loading && isExecutor}}" class="notice">
    <text class="notice-icon">i</text>
    <text>材料、审批和项目进度来自同一 ERP；付款与核销操作仍由服务器按角色授权。</text>
  </view>
</view>
