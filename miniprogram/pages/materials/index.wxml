<view class="wrap">
  <block wx:if="{{directoryOpen}}">
    <view class="card card-accent">
      <view class="page-kicker">MATERIAL WORKBENCH</view>
      <view class="heading">材料收集</view>
      <view class="subtitle">按项目名称建立目录，点击项目查看材料详情、上传记录与附件</view>
      <view wx:if="{{directoryStats}}" class="material-stat-grid">
        <view class="material-stat"><text class="material-stat-value">{{directoryStats.projects}}</text><text>项目目录</text></view>
        <view class="material-stat"><text class="material-stat-value">{{directoryStats.uploaded}}</text><text>已收集材料项目</text></view>
        <view class="material-stat"><text class="material-stat-value">{{directoryStats.total}}</text><text>已登记材料</text></view>
      </view>
    </view>
    <view class="card">
      <view class="row"><text class="title grow">项目材料目录</text><text class="muted">{{directoryProjects.length}} 个项目</text></view>
      <input class="field-control space-sm" type="text" value="{{directorySearch}}" bindinput="searchDirectory" placeholder="搜索项目名称 / 会议编号 / 状态"/>
      <view wx:if="{{directoryLoading}}" class="field-hint">正在加载项目目录…</view>
      <view wx:elif="{{directoryError}}" class="error">{{directoryError}}<button size="mini" bindtap="loadDirectory">重试</button></view>
      <block wx:else>
        <view wx:for="{{directoryProjects}}" wx:key="id" class="material-project-folder" data-pid="{{item.id}}" bindtap="openDirectoryProject">
          <view class="material-folder-icon">📁</view>
          <view class="grow"><view class="title">{{item.name}}</view><view class="muted">{{item.id}}</view><view class="muted">{{item.status}}<text wx:if="{{directoryStats}}"> · {{item.count||0}} 份材料 · {{item.have.length||0}} 类</text></view></view>
          <text class="picker-arrow">›</text>
        </view>
        <view wx:if="{{!directoryProjects.length}}" class="field-hint">没有符合条件的项目</view>
      </block>
    </view>
  </block>
  <block wx:else>
  <view class="card card-accent">
    <view class="page-kicker">MATERIAL WORKBENCH</view>
    <button size="mini" class="btn ghost" bindtap="backDirectory" disabled="{{busy||archiveOpen}}">← 返回项目目录</button>
    <view class="heading">{{projects[index].name||"材料收集"}}</view>
    <view class="subtitle">材料收集 / {{pid}} · {{projects[index].status}}</view>
    <view class="field space-sm">
      <view class="field-label"><text class="required">*</text>所属会议</view>
      <picker mode="selector" range="{{projects}}" range-key="name" value="{{index}}" bindchange="select">
        <view class="picker-control"><text class="picker-value">{{projects[index].name||'请选择会议项目'}}</text><text class="picker-arrow">⌄</text></view>
      </picker>
    </view>
    <view wx:if="{{canMaterialRead&&!filesLoading}}" class="material-stat-grid">
      <view class="material-stat"><text class="material-stat-value">{{materialStats.count}}</text><text>已登记材料</text></view>
      <view class="material-stat"><text class="material-stat-value">{{materialStats.uploaded}}</text><text>已上传原件</text></view>
      <view class="material-stat"><text class="material-stat-value">{{materialStats.kinds}}</text><text>材料类别</text></view>
    </view>
    <view wx:if="{{locked}}" class="lock-banner"><view class="lock-mark">锁</view><view class="grow"><view class="title">材料已冻结</view><view class="muted">项目已结算或归档，仅可查阅已上传原件，不可上传或删除。</view></view></view>
  </view>

  <view wx:if="{{archiveAllowed}}" class="card">
    <button class="btn ghost" disabled="{{busy||archiveOpen}}" bindtap="openArchive">材料下载 · PDF / PPTX</button>
    <view wx:if="{{archiveError&&!archiveOpen}}" class="error">{{archiveError}}</view>
  </view>
  <view wx:if="{{archiveOpen}}" class="card">
    <view class="row"><view class="title grow">数字卷宗 · 资料选择</view><button size="mini" disabled="{{busy}}" bindtap="closeArchive">关闭</button></view>
    <view class="muted">与 Web 使用同一份资料来源和固定类目顺序，重复原件由服务器去重。可按需选择并在同类目内排序。</view>
    <view class="row"><button size="mini" data-all="yes" bindtap="selectArchiveAll" disabled="{{busy}}">全选</button><button size="mini" data-all="no" bindtap="selectArchiveAll" disabled="{{busy}}">清空</button></view>
    <view wx:for="{{archiveSources}}" wx:key="id" class="item">
      <view class="row" data-id="{{item.id}}" bindtap="toggleArchiveSource"><checkbox checked="{{item.checked}}" disabled="{{busy}}"/><view class="grow"><view>{{item.name}}</view><view class="muted">{{item.kind}} · {{item.generated?'系统生成摘要':item.fileName}}</view></view></view>
      <view class="row"><button size="mini" disabled="{{busy||index===0||archiveSources[index-1].kind!==item.kind}}" data-id="{{item.id}}" data-delta="-1" bindtap="moveArchiveSource">上移</button><button size="mini" disabled="{{busy||index===archiveSources.length-1||archiveSources[index+1].kind!==item.kind}}" data-id="{{item.id}}" data-delta="1" bindtap="moveArchiveSource">下移</button></view>
    </view>
    <view wx:if="{{archiveCustomWatermark}}" class="field"><view class="field-label">PDF 水印</view><picker range="{{archiveWatermarkOptions}}" value="{{archiveWatermarkMode}}" bindchange="archiveWatermarkChange" disabled="{{busy}}"><view class="picker-control">{{archiveWatermarkMode===0?'操作员＋时间':archiveWatermarkMode===1?'无水印':'自定义水印'}}</view></picker><input wx:if="{{archiveWatermarkMode===2}}" class="field-control" value="{{archiveWatermarkText}}" maxlength="80" bindinput="archiveWatermarkInput" placeholder="自定义文字"/></view>
    <view wx:else class="muted">PDF 默认标注操作员和生成时间。</view>
    <view wx:if="{{archiveError}}" class="error">{{archiveError}}</view>
    <button class="btn primary" data-format="pdf" bindtap="exportArchive" loading="{{busy}}" disabled="{{busy}}">生成并查看 PDF</button>
    <button class="btn ghost" data-format="pptx" bindtap="exportArchive" disabled="{{busy}}">生成并查看 PPTX</button>
  </view>
  <view wx:if="{{!archiveOpen}}" class="form-section">
    <view class="section-head"><view class="row"><view class="section-index">01</view><view class="section-caption">按类别查看及录入材料</view></view></view>
    <view class="muted">点击类别查看已有原件；获得写入权限且未冻结时可上传。合同与 Web 正式台账共用，归档后仍可查阅。</view>
    <view class="chip-list">
      <view wx:if="{{pid&&canContractRead}}" bindtap="chooseContracts" class="select-chip {{contractMode?'chip-selected':''}}">合同</view>
      <view wx:for="{{kindCounts}}" wx:key="kind" data-kind="{{item.kind}}" bindtap="chooseKind" class="select-chip {{!contractMode&&!custom&&kind===item.kind?'chip-selected':''}}">{{item.kind}}<text wx:if="{{item.count}}" class="muted"> {{item.count}}份</text></view>
      <view wx:if="{{canMaterialWrite&&!locked}}" bindtap="chooseCustom" class="select-chip {{!contractMode&&custom?'chip-selected':''}}">＋ 自定义</view>
    </view>
    <view wx:if="{{historyKinds.length}}" class="field-hint">已录入的其他类别：</view>
    <view wx:if="{{historyKinds.length}}" class="chip-list">
      <view wx:for="{{historyCounts}}" wx:key="kind" data-kind="{{item.kind}}" bindtap="chooseKind" class="select-chip {{!contractMode&&!custom&&kind===item.kind?'chip-selected':''}}">{{item.kind}}<text wx:if="{{item.disabled}}" class="muted"> 已停用</text><text wx:elif="{{item.count}}" class="muted"> {{item.count}}份</text></view>
    </view>
    <view wx:if="{{filesLoading}}" class="field-hint">正在同步项目材料及权限…</view>
    <view wx:if="{{error&&!canMaterialRead}}" class="error">{{error}}</view>
    <view wx:if="{{contractMode}}" class="uploaded-file-list">
      <view class="uploaded-file-head">
        <text class="uploaded-file-title">合同目录</text>
        <text class="uploaded-file-count">{{contractRows.length}} 份</text>
      </view>
      <view class="field-hint">合同上传后自动登记到 Web 正式合同台账并同步归档原件。提交待签署合同仍须按现有权限审批。</view>
      <view wx:if="{{canUploadContract}}" class="card space-sm">
        <view class="section-caption">上传合同</view>
        <view class="field">
          <view class="field-label"><text class="required">*</text>合同类别</view>
          <picker mode="selector" range="{{contractTypes}}" range-key="label" value="{{contractDraft.categoryIndex}}" disabled="{{busy}}" bindchange="contractCategoryChange">
            <view class="picker-control"><text>{{contractTypes[contractDraft.categoryIndex].label}}</text><text class="picker-arrow">⌄</text></view>
          </picker>
        </view>
        <button class="upload-panel" disabled="{{busy}}" bindtap="pickContractFile" data-source="photo">
          <view class="upload-icon">照</view><view class="upload-title">拍照或从相册选择合同</view><view class="upload-sub">单份文件不超过20 MB</view>
        </button>
        <button class="upload-panel" disabled="{{busy}}" bindtap="pickContractFile" data-source="file">
          <view class="upload-icon">档</view><view class="upload-title">从微信会话选择合同文件</view><view class="upload-sub">支持 PDF、Office、图片等格式</view>
        </button>
        <view wx:if="{{contractDraft.file}}" class="field-hint">已上传原件：{{contractDraft.file.name}}</view>
        <view wx:if="{{contractDraft.scanNote}}" class="field-hint">{{contractDraft.scanNote}}</view>
        <view class="field"><view class="field-label"><text class="required">*</text>合同名称</view><input class="field-control" value="{{contractDraft.name}}" data-key="name" bindinput="contractDraftInput" maxlength="80" disabled="{{busy}}" placeholder="自动填入文件名，可修改"/></view>
        <view class="field"><view class="field-label"><text class="required">*</text>签约方</view><input class="field-control" value="{{contractDraft.vendor}}" data-key="vendor" bindinput="contractDraftInput" maxlength="80" disabled="{{busy}}" placeholder="OCR 识别或手工填写"/></view>
        <view class="field"><view class="field-label"><text class="required">*</text>合同金额（元）</view><input class="field-control" type="digit" value="{{contractDraft.amount}}" data-key="amount" bindinput="contractDraftInput" disabled="{{busy}}" placeholder="核对合同金额或劳务报酬"/></view>
        <view wx:if="{{contractDraft.categoryIndex===2}}" class="field"><view class="field-label">赞助权益（每行一项）</view><textarea class="field-control" value="{{contractDraft.rightsText}}" data-key="rightsText" bindinput="contractDraftInput" disabled="{{busy}}" placeholder="OCR识别后人工核对，可自定义权益"/></view>
        <view class="field"><view class="field-label">签署日期{{contractDraft.statusIndex===2?'（必填）':'（选填）'}}</view><picker mode="date" value="{{contractDraft.signDate}}" disabled="{{busy}}" bindchange="contractDateChange"><view class="picker-control"><text>{{contractDraft.signDate||'选择日期'}}</text><text class="picker-arrow">⌄</text></view></picker></view>
        <view class="field"><view class="field-label">合同状态</view><picker mode="selector" range="{{contractStatuses}}" value="{{contractDraft.statusIndex}}" disabled="{{busy}}" bindchange="contractStatusChange"><view class="picker-control"><text>{{contractStatuses[contractDraft.statusIndex]}}</text><text class="picker-arrow">⌄</text></view></picker></view>
        <view class="field-hint">OCR 仅预填，须核对原件。选择「待签署」或「已签署」后，正式环境仍须通过签署审批才能确认已签署。</view>
        <button class="btn primary" loading="{{busy}}" disabled="{{busy||!contractDraft.file}}" bindtap="saveContract">{{contractDraft.statusIndex>0?'保存并提交签署':'保存合同'}}</button>
      </view>
      <view wx:elif="{{!contractsLoading&&!contractError}}" class="field-hint">当前账号或会议状态不允许新增合同，可查看已有原件。</view>
      <view wx:if="{{contractNotice}}" class="field-hint">{{contractNotice}}</view>
      <view wx:if="{{contractsLoading}}" class="field-hint">正在加载合同目录…</view>
      <view wx:elif="{{contractError}}" class="error">{{contractError}}</view>
      <view wx:elif="{{contractRows.length}}">
        <view wx:for="{{contractRows}}" wx:key="id" class="item">
          <view class="row"><text class="title">{{item.name}}</text><text>{{item.status}}</text></view>
          <view class="muted">{{item.category}} · {{item.vendor}} · {{item.id}}</view>
          <view class="muted">金额：¥{{item.amount}} · 签署日期：{{item.signDate||"—"}}</view>
          <view class="muted">录入：{{item.creator||"—"}} {{item.createdAt}}</view>
          <view wx:if="{{item.remark}}" class="muted">备注：{{item.remark}}</view>
          <view wx:if="{{item.fileKey}}" class="row">
            <text class="grow">{{item.fileName||'合同原件'}}</text>
            <button size="mini" class="btn ghost" data-id="{{item.id}}" bindtap="openContractOriginal">查看原件</button>
          </view>
          <view wx:else class="field-hint">暂无合同原件</view>
          <view class="row" style="flex-wrap:wrap;gap:8px">
            <button wx:if="{{item.canEdit}}" size="mini" class="btn ghost" data-id="{{item.id}}" disabled="{{busy}}" bindtap="editContractCategory">修改</button>
            <button wx:if="{{item.canReplace}}" size="mini" class="btn ghost" data-id="{{item.id}}" disabled="{{busy}}" bindtap="replaceOriginal">更换原件</button>
            <button wx:if="{{item.canDelete}}" size="mini" type="warn" data-id="{{item.id}}" data-action="delete" disabled="{{busy}}" bindtap="contractAction">删除</button>
            <button wx:if="{{item.canArchiveDelete}}" size="mini" type="warn" data-id="{{item.id}}" data-action="archiveDelete" disabled="{{busy}}" bindtap="contractAction">特殊删除（总管理员）</button>
            <button wx:if="{{item.canSubmit}}" size="mini" class="btn ghost" data-id="{{item.id}}" data-action="submit" disabled="{{busy}}" bindtap="contractAction">提交签署</button>
            <button wx:if="{{item.canSign}}" size="mini" class="btn ghost" data-id="{{item.id}}" data-action="sign" disabled="{{busy}}" bindtap="contractAction">确认签署</button>
            <button wx:if="{{item.canSign}}" size="mini" type="warn" data-id="{{item.id}}" data-action="reject" disabled="{{busy}}" bindtap="contractAction">驳回</button>
            <button wx:if="{{item.canReviewReplace}}" size="mini" class="btn ghost" data-id="{{item.id}}" disabled="{{busy}}" bindtap="reviewReplaceContract">签署前更新原件</button>
            <button wx:if="{{item.canAmend}}" size="mini" class="btn ghost" data-id="{{item.id}}" disabled="{{busy}}" bindtap="amendContract">申请合同更正</button>
            <button wx:if="{{item.canHistory}}" size="mini" class="btn ghost" data-id="{{item.id}}" bindtap="contractHistory">版本历史</button>
          </view>
        </view>
      </view>
      <view wx:else class="field-hint">本会议暂无合同记录。</view>
      <view wx:if="{{historyContract}}" class="card space-sm"><view class="row"><text class="title grow">{{historyContract}} · 更正记录</text><button size="mini" bindtap="closeHistory">关闭</button></view>
        <view wx:for="{{historyRows}}" wx:key="id" class="item"><view class="title">{{item.id}} · {{item.status}}</view><view class="muted">{{item.kind}} · {{item.createdAt}}</view><view>{{item.reason}}</view><button wx:if="{{item.oldKey}}" size="mini" data-key="{{item.oldKey}}" bindtap="openHistoryOriginal">旧原件</button><button wx:if="{{item.newKey}}" size="mini" data-key="{{item.newKey}}" bindtap="openHistoryOriginal">更正原件</button></view>
        <view wx:if="{{!historyRows.length}}" class="field-hint">暂无更正记录</view>
      </view>
    </view>
    <block wx:elif="{{canMaterialRead}}">
    <view wx:if="{{custom}}" class="field">
      <view class="field-label"><text class="required">*</text>自定义类别</view>
      <input class="field-control" value="{{customKind}}" data-key="customKind" bindinput="input" placeholder="20 字以内"/>
    </view>
    <view wx:if="{{canMaterialWrite&&!locked&&!custom&&kind==='权益照片'}}" class="field">
      <view class="field-label"><text class="required">*</text>赞助合同 · 权益二级类目</view>
      <picker mode="selector" range="{{sponsorRights}}" range-key="label" value="{{rightIndex}}" bindchange="pickRight"><view class="picker-control"><text class="picker-value">{{sponsorRights[rightIndex].label}}</text><text class="picker-arrow">⌄</text></view></picker>
      <view class="field-hint">权益类目需先在 Web 端确认，照片才能关联到对应赞助合同。</view>
    </view>
    <view class="category-upload-caption">当前类别：{{custom?(customKind||'请填写自定义类别'):kind}}</view>
    <view wx:if="{{categoryDisabled}}" class="field-hint">当前材料类别已停用，仅可查看历史附件。</view>
    <view wx:if="{{canMaterialWrite&&!locked}}" class="notice"><text class="notice-icon">i</text><text>每份材料自动采用对应文件名，无须逐份手工填写名称。单批最多10份。</text></view>
    <view wx:if="{{canMaterialWrite&&!locked&&!custom&&kind==='讲者照片'}}" class="field-hint">讲者照片：可直接用下方「拍照或从相册选择」批量选图，选完逐张填写讲者姓名（姓名即材料名称）；也可从微信会话选择已用姓名命名的图片（如张三.jpg），系统按文件名关联。</view>
    <view wx:if="{{canMaterialWrite&&!locked&&!custom&&kind==='终版议程'}}" class="field-hint">可同时选择最多10份议程，按选择顺序登记，最后一份作为唯一当前终版，其余为历史版。</view>
    <view wx:if="{{error}}" class="error"><text class="feedback-icon">!</text><text>{{error}}</text></view>
    <view wx:if="{{uploaded}}" class="success-note"><text class="feedback-icon">✓</text><text>{{uploaded}}</text></view>

    <button wx:if="{{canMaterialWrite&&!locked}}" class="upload-panel" loading="{{busy}}" disabled="{{busy||!canMaterialWrite||locked||filesLoading||categoryDisabled||!pid||(custom&&!customKind)||(!custom&&kind==='权益照片'&&!rightId)}}" bindtap="addPhoto">
      <view class="upload-icon">照</view><view class="upload-title">拍照或从相册选择</view><view class="upload-sub">{{!custom&&kind==='讲者照片'?'相册批量选图，选完逐张填写讲者姓名':'相册可批量选择照片，每批最多10份'}}</view>
    </button>
    <button wx:if="{{canMaterialWrite&&!locked}}" class="upload-panel" loading="{{busy}}" disabled="{{busy||!canMaterialWrite||locked||filesLoading||categoryDisabled||!pid||(custom&&!customKind)||(!custom&&kind==='权益照片'&&!rightId)}}" bindtap="addFile">
      <view class="upload-icon" style="background:#1f5f8b">档</view><view class="upload-title">从微信会话选择文件</view><view class="upload-sub">一次最多选择10份 Office、PDF、CSV、TXT 或图片</view>
    </button>
    <view wx:if="{{!custom&&kind==='讲者照片'&&speakerFiles.length}}" class="speaker-block">
      <view class="speaker-head">
        <view class="speaker-title">待命名的讲者照片 · {{speakerFiles.length}} 张</view>
        <view class="speaker-desc">为每张填写讲者姓名，姓名即材料名称，每名讲者一张。</view>
      </view>
      <view wx:for="{{speakerFiles}}" wx:key="uid" class="speaker-item">
        <image class="speaker-thumb" src="{{item.path}}" mode="aspectFill"/>
        <view class="speaker-main">
          <input class="speaker-input" value="{{item.name}}" data-index="{{index}}" bindinput="inputSpeakerName" placeholder="讲者姓名（必填）" disabled="{{busy}}" maxlength="120"/>
          <view wx:if="{{item.error}}" class="speaker-state err">{{item.error}}</view>
          <view wx:else class="speaker-state">待上传</view>
        </view>
        <view wx:if="{{!busy}}" class="speaker-del" data-index="{{index}}" bindtap="removeSpeaker">移除</view>
      </view>
      <button class="btn primary speaker-submit" loading="{{busy}}" disabled="{{busy||!canMaterialWrite||locked||filesLoading||categoryDisabled||!pid}}" bindtap="uploadSpeakers">上传并归档（{{speakerFiles.length}} 张）</button>
    </view>
    <view wx:if="{{batchResults.length}}" class="card">
      <view class="section-caption">本批文件进度 · {{batchResults.length}}份</view>
      <view wx:for="{{batchResults}}" wx:key="name" class="item">
        <view class="row"><text class="title">{{item.name}}</text><text>{{item.status}}</text></view>
        <view wx:if="{{item.speaker}}" class="muted">文件名关联讲者：{{item.speaker}}</view>
        <view wx:if="{{item.error}}" class="error">{{item.error}}</view>
      </view>
      <button wx:if="{{!busy&&error}}" class="btn ghost" bindtap="retryFailed">重试未成功文件</button>
    </view>
    <view class="uploaded-file-list">
      <view class="uploaded-file-head">
        <text class="uploaded-file-title">已收集材料详情</text>
        <text class="uploaded-file-count">{{visibleFiles.length}} 份</text>
      </view>
      <view class="row"><button size="mini" class="btn {{allMaterials?'primary':'ghost'}}" data-mode="all" bindtap="toggleAllMaterials" disabled="{{busy}}">全部材料</button><button size="mini" class="btn {{!allMaterials?'primary':'ghost'}}" data-mode="category" bindtap="toggleAllMaterials" disabled="{{busy}}">当前类别</button></view>
      <view class="field-hint">点击文件名或「查看原件」即可查阅已上传附件。合同历史材料通过合同目录管理。</view>
      <view wx:if="{{canMaterialWrite&&!materialMutationLocked}}" class="field-hint">文件传错了？点击该文件右侧「删除」并确认。删除后进入废件箱，仅总管理员可恢复。</view>
      <view wx:if="{{filesLoading}}" class="field-hint">正在加载已上传材料…</view>
      <view wx:elif="{{visibleFiles.length}}">
        <view wx:for="{{visibleFiles}}" wx:key="id" class="uploaded-file-item">
          <view class="grow material-record-main">
            <view class="muted">{{item.kind}}<text wx:if="{{item.kind==='权益照片'}}"> · {{item.sponsor_enterprise||'未关联赞助合同'}} · {{item.sponsor_right_category||'未关联权益类目'}}</text></view>
            <view class="uploaded-file-name" data-id="{{item.id}}" bindtap="openMaterialOriginal">{{item.name||item.filename}}</view>
            <view wx:if="{{item.file_key&&item.filename!==item.name}}" class="muted">{{item.filename}}</view>
            <view class="muted">版本：{{item.version||'—'}} · {{item.uploader||'—'}} {{item.created_at||''}}</view>
            <view wx:if="{{!item.file_key}}" class="muted">暂无原件</view>
          </view>
          <button wx:if="{{item.file_key}}" size="mini" class="btn ghost" data-id="{{item.id}}" catchtap="openMaterialOriginal">查看原件</button>
          <button wx:if="{{item.file_key&&!item.contractEvidence&&canMaterialReplace&&!materialMutationLocked}}" size="mini" class="btn ghost" data-id="{{item.id}}" disabled="{{busy}}" catchtap="replaceOriginal">修改</button>
          <button wx:if="{{!item.contractEvidence&&canMaterialWrite&&!materialMutationLocked}}" type="warn" size="mini" class="uploaded-file-delete"
            data-id="{{item.id}}" disabled="{{busy}}" loading="{{deletingId===item.id}}"
            catchtap="removeUploaded">删除</button>
        </view>
      </view>
      <view wx:else class="field-hint">{{locked||!canMaterialWrite?'该类别暂无已上传文件。':'该类别暂无已上传文件，选择上方入口即可录入。'}}</view>
    </view>
    <view wx:if="{{!custom&&(kind==='协会报销'||kind==='其他费用')}}" class="field-hint">票据归入本项目，会议核销后在财务付款明细中确认票号、实际收款方和金额。</view>
    <view class="privacy-note">每批最多10份文件，单个附件不超过20 MB。OCR 仅辅助识别，不代表核销通过。</view>
    </block>
  </view>
  </block>
</view>
