/* 讲者照片：相册图无原始文件名，选图后逐张填写姓名再上传 */
.speaker-block { margin-top: 20rpx; }

.speaker-head {
  padding: 20rpx 22rpx;
  margin-bottom: 16rpx;
  background: #f4f8fd;
  border: 1rpx solid #d9e6f5;
  border-radius: 16rpx;
}
.speaker-title { color: #253348; font-size: 26rpx; font-weight: 700; }
.speaker-desc { margin-top: 6rpx; color: #6b7c91; font-size: 22rpx; line-height: 1.5; }

.speaker-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 14rpx 16rpx;
  margin-bottom: 12rpx;
  background: #ffffff;
  border: 1rpx solid #e3e8ef;
  border-radius: 16rpx;
}
.speaker-thumb {
  flex: 0 0 auto;
  width: 108rpx;
  height: 108rpx;
  border-radius: 12rpx;
  background: #eef2f7;
}
.speaker-main { flex: 1; min-width: 0; }
.speaker-input {
  width: 100%;
  height: 64rpx;
  padding: 0 16rpx;
  color: #1a2330;
  font-size: 26rpx;
  background: #f7f9fc;
  border: 1rpx solid #dfe6ef;
  border-radius: 10rpx;
}
.speaker-state { margin-top: 8rpx; color: #8593a5; font-size: 21rpx; }
.speaker-state.err { color: #c0392b; }

.speaker-del {
  flex: 0 0 auto;
  padding: 8rpx 14rpx;
  color: #c0392b;
  font-size: 22rpx;
  background: #fdf5f4;
  border: 1rpx solid #f0d2cd;
  border-radius: 10rpx;
}

.speaker-submit { margin-top: 16rpx; }

/* 单页按类别录入：选择后直接上传，并展示当前类别的真实归档文件名。 */
.category-upload-caption {
  margin: 28rpx 0 16rpx;
  padding: 14rpx 20rpx;
  border-left: 6rpx solid #2f78c4;
  background: #f1f7fe;
  color: #244a75;
  font-size: 26rpx;
  font-weight: 700;
}
.uploaded-file-list {
  margin-top: 24rpx;
  padding: 22rpx;
  border: 1rpx solid #dbe6f3;
  border-radius: 16rpx;
  background: #fff;
}
.uploaded-file-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}
.uploaded-file-title { font-size: 27rpx; font-weight: 700; color: #24374e; }
.uploaded-file-count { font-size: 23rpx; color: #647b96; }
.uploaded-file-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  justify-content: space-between;
  padding: 17rpx 0;
  border-top: 1rpx solid #eef2f7;
}
.uploaded-file-name {
  flex: 1;
  min-width: 0;
  color: #253348;
  font-size: 25rpx;
  overflow-wrap: anywhere;
  word-break: break-all;
}
.uploaded-file-version {
  flex: 0 0 auto;
  font-size: 21rpx;
  color: #1c7394;
}

/* 已上传误传文件可纠错删除；仅移至废件箱，不允许在前端物理清除原件。 */
.uploaded-file-delete {
  flex: 0 0 auto;
  margin: 0;
  padding: 0 12rpx;
  min-width: 92rpx;
  border: 1rpx solid #f0d2cd;
  border-radius: 10rpx;
  background: #fff6f5;
  color: #bb3028;
  font-size: 22rpx;
  line-height: 55rpx;
}
.uploaded-file-delete::after { border: none; }
.uploaded-file-delete[disabled] { opacity: .5; }

/* Mobile rendering of the shared Web project directory and material statistics. */
.material-stat-grid { display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12rpx;margin-top:24rpx; }
.material-stat-grid-directory { grid-template-columns:repeat(2,minmax(0,1fr)); }
.material-stat { display:flex;flex-direction:column;gap:6rpx;padding:16rpx 10rpx;background:#f4f8fd;border:1rpx solid #e3eaf4;border-radius:12rpx;font-size:20rpx;text-align:center;color:#60748d; }
.material-stat-value { color:#23476d;font-size:34rpx;font-weight:700; }
.material-project-folder { display:flex;align-items:center;gap:16rpx;padding:22rpx 0;border-bottom:1rpx solid #e9eef4; }
.material-folder-icon { font-size:42rpx;flex-shrink:0; }
.material-record-main { min-width:0;overflow-wrap:anywhere; }
.uploaded-file-item { flex-wrap:wrap;align-items:center; }
