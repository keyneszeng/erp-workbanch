/* 讲者照片：相册图无原始文件名，选图后逐张填写姓名再上传 */
.speaker-block { margin-top: 20rpx; }

.speaker-head {
  padding: 20rpx 22rpx;
  margin-bottom: 16rpx;
  background: #f4f8fd;
  border: 1rpx solid #d9e6f5;
  border-radius: 16rpx;
}
.speaker-title { color: #253348; font-size: 26rpx; font-weight: 700; }
.speaker-desc { margin-top: 6rpx; color: #6b7c91; font-size: 22rpx; line-height: 1.5; }

.speaker-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 14rpx 16rpx;
  margin-bottom: 12rpx;
  background: #ffffff;
  border: 1rpx solid #e3e8ef;
  border-radius: 16rpx;
}
.speaker-thumb {
  flex: 0 0 auto;
  width: 108rpx;
  height: 108rpx;
  border-radius: 12rpx;
  background: #eef2f7;
}
.speaker-main { flex: 1; min-width: 0; }
.speaker-input {
  width: 100%;
  height: 64rpx;
  padding: 0 16rpx;
  color: #1a2330;
  font-size: 26rpx;
  background: #f7f9fc;
  border: 1rpx solid #dfe6ef;
  border-radius: 10rpx;
}
.speaker-state { margin-top: 8rpx; color: #8593a5; font-size: 21rpx; }
.speaker-state.err { color: #c0392b; }

.speaker-del {
  flex: 0 0 auto;
  padding: 8rpx 14rpx;
  color: #c0392b;
  font-size: 22rpx;
  background: #fdf5f4;
  border: 1rpx solid #f0d2cd;
  border-radius: 10rpx;
}

.speaker-submit { margin-top: 16rpx; }
