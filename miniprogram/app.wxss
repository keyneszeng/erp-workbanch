page{background:#f3f7fc;color:#142d51;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif}
.wrap{padding:28rpx;padding-bottom:calc(40rpx + env(safe-area-inset-bottom))}
.card{background:#fff;border-radius:26rpx;padding:34rpx;border:1rpx solid #d9e5f3}
.heading{font-size:38rpx;font-weight:700;line-height:1.45;margin:12rpx 0}
.subtitle{font-size:26rpx;color:#7286a0;margin-bottom:28rpx}
.body{white-space:pre-wrap;line-height:1.85;font-size:28rpx}
.note{font-size:23rpx;color:#7187a2;margin-top:24rpx}
.btn{margin-top:18rpx;background:#eaf4ff;color:#1067c6;border-radius:16rpx}
.btn.primary{background:#1169d6;color:#fff}
.status{padding:24rpx;background:#e9f5ff;color:#155eae;border-radius:12rpx;margin:18rpx 0;font-size:25rpx}
.error{background:#fff0f0;color:#c33434}
