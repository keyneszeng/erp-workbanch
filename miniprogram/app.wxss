page{background:#f5f7fb;color:#172339;font-size:30rpx}
.wrap{padding:28rpx}.card{background:#fff;border-radius:18rpx;margin:0 0 22rpx;padding:28rpx;box-shadow:0 2rpx 12rpx #152c4710}
.heading{font-size:38rpx;font-weight:650;margin-bottom:18rpx}.title{font-size:34rpx;font-weight:600;margin:12rpx 0}
.muted{color:#718096;font-size:25rpx}.error{color:#be2535;font-size:26rpx;margin:18rpx 0}.field{padding:22rpx 0;border-bottom:1rpx solid #edf0f5}
.btn{margin:16rpx 0;background:#eaf0fc;color:#2650a9}.primary{background:#1954bd;color:#fff}
.row{display:flex;justify-content:space-between;align-items:center;gap:12rpx}.tag{font-size:24rpx;color:#3761a1}
.item{padding:20rpx 4rpx;border-top:1rpx solid #eff1f5}.space{height:18rpx}


/* 图示 C 区：小程序轻量化卡片布局，使用系统原生点击与可读的状态标签 */
.home-hero{background:linear-gradient(125deg,#165ac4,#5c9ff5);color:#fff;padding:42rpx 34rpx;border-radius:22rpx;margin-bottom:22rpx}
.hero-eyebrow{font-size:23rpx;opacity:.82;letter-spacing:2rpx}
.hero-heading{font-size:43rpx;font-weight:700;margin:12rpx 0}
.hero-sub{font-size:24rpx;opacity:.93}
.quick-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18rpx;margin:0 0 22rpx}
.quick-tile{padding:26rpx 20rpx;border-radius:18rpx;min-height:176rpx;display:flex;flex-direction:column;justify-content:center}
.quick-blue{background:#dfecff;color:#124db4}.quick-green{background:#d9f6ea;color:#087a53}
.quick-orange{background:#ffecd6;color:#ac5a12}.quick-purple{background:#eee2ff;color:#7444c2}
.quick-light{background:#eaf0fa;color:#32547f}
.quick-icon{font-size:43rpx;line-height:1.1;font-weight:700}
.quick-title{font-size:31rpx;font-weight:700;margin:9rpx 0 3rpx}
.quick-sub{font-size:23rpx;opacity:.8}
.metric-strip{display:flex;justify-content:space-around;margin-top:26rpx}
.metric{text-align:center;min-width:0}.metric-num{font-size:38rpx;font-weight:700;color:#2354af}
.section-caption{font-size:29rpx;font-weight:700;color:#223e69;margin-bottom:13rpx}
.field input,.field textarea{display:block;width:100%;margin-top:12rpx;font-size:29rpx;color:#172339}
.field textarea{min-height:140rpx}
.field-value{color:#2c5796;margin-top:7rpx}
.required{color:#df5246;font-weight:700}
.action-row{display:flex;gap:18rpx;margin-bottom:28rpx}
.action-row .btn{flex:1}
.ghost{background:#fff;color:#2759ac;border:2rpx solid #b6c9eb}
.tab-row{display:flex;border-bottom:1rpx solid #e2e9f3;margin-bottom:22rpx}
.tab-item{padding:14rpx 20rpx;color:#66748d;font-size:27rpx}
.tab-item.selected{color:#1655bc;font-weight:700;border-bottom:5rpx solid #1655bc}
.meeting-item{padding:22rpx 0;border-bottom:1rpx solid #e9edf4}
.meeting-name{font-weight:650;font-size:29rpx;flex:1;min-width:0}
.empty-state{text-align:center;padding:48rpx 12rpx;color:#758298;font-size:25rpx}
.progress-track{height:13rpx;border-radius:14rpx;background:#eaf0f8;overflow:hidden;margin:12rpx 0}
.progress-fill{height:100%;background:#2574df;border-radius:14rpx}
.whitespace{white-space:pre-wrap}
.chip-list{display:flex;flex-wrap:wrap;gap:12rpx;padding:14rpx 0}
.select-chip{background:#f3f7fc;border:2rpx solid #dce5f0;border-radius:10rpx;padding:12rpx 18rpx;font-size:25rpx;color:#49617f}
.chip-selected{background:#dfedff;border-color:#3878d2;color:#1f5ebd;font-weight:650}
.success-note{padding:16rpx;color:#147848;background:#e8f7ed;border-radius:10rpx;margin:13rpx 0}
