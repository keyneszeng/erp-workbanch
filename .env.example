# Example only. Values are not loaded automatically by Node.
NODE_ENV=production
ERP_DEPLOY_TARGET=aliyun-ecs
ERP_DEMO_MODE=0
ERP_PRODUCTION_DOMAIN=production.example.com
# 正式环境首次初始化必须配置：总管理员手机号
ERP_BOOTSTRAP_ADMIN_PHONE=
ERP_DB=/var/lib/erp/erp.db
ERP_UPLOAD_DIR=/var/lib/erp/uploads
ERP_HOST=127.0.0.1
ERP_PORT=8787
ERP_TRUST_PROXY=1
ERP_SESSION_FALLBACK=0
ERP_SECRET=
# 正式短信验证码：阿里云短信（Dysmsapi）或腾讯云 SMS。绝不可提交密钥。
ERP_SMS_PROVIDER=aliyun
ERP_ALIYUN_SMS_ACCESS_KEY_ID=
ERP_ALIYUN_SMS_ACCESS_KEY_SECRET=
ERP_ALIYUN_SMS_SIGN_NAME=
ERP_ALIYUN_SMS_TEMPLATE_CODE=
ERP_ALIYUN_SMS_REGION=cn-hangzhou
# 腾讯云兼容配置（ERP_SMS_PROVIDER=tencent 时使用）
# ERP_TENCENT_SECRET_ID=
# ERP_TENCENT_SECRET_KEY=
# ERP_TENCENT_SMS_APP_ID=
# ERP_TENCENT_SMS_SIGN=
# ERP_TENCENT_SMS_TEMPLATE_ID=
# ERP_TENCENT_SMS_REGION=ap-guangzhou
# 仅自动化测试：NODE_ENV=test ERP_SMS_PROVIDER=test ERP_SMS_TEST_MODE=1

# 材料/议程 OCR 引擎（三选一，默认 tesseract）
#   tesseract  本机 tesseract + poppler，纯 CPU，无需额外服务
#   unlimited  自建 Unlimited-OCR（vLLM / SGLang 的 OpenAI 兼容接口），需要 GPU
#   baidu      百度云「文档解析（Unlimited-OCR）」异步 API，无需 GPU，按页计费
ERP_OCR_ENABLED=0
ERP_OCR_PROVIDER=tesseract
# 远端引擎失败时是否退回 tesseract（默认开；设 0 则直接报错，便于发现配置问题）
ERP_OCR_FALLBACK=1

# 自建 Unlimited-OCR（ERP_OCR_PROVIDER=unlimited 时必填）
# vLLM: vllm serve baidu/Unlimited-OCR --served-model-name Unlimited-OCR --port 8000
ERP_OCR_HTTP_URL=
ERP_OCR_HTTP_MODEL=Unlimited-OCR
# 服务若开了鉴权才填
ERP_OCR_HTTP_KEY=
# 单次识别超时（毫秒）。3B 模型多页推理较慢，别低于 60000
ERP_OCR_HTTP_TIMEOUT_MS=120000

# 百度云 Unlimited-OCR（ERP_OCR_PROVIDER=baidu 时必填）
# 控制台 → 文字识别 → 应用列表，创建应用后取 API Key / Secret Key
ERP_BAIDU_OCR_API_KEY=
ERP_BAIDU_OCR_SECRET_KEY=
# 解析是异步任务：提交后每 2 秒轮询一次，超过这个时长报超时
ERP_BAIDU_OCR_TIMEOUT_MS=120000
