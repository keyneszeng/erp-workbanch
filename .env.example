# Example only. Values are not loaded automatically by Node.
ERP_DEMO_MODE=0
# 正式环境首次初始化必须配置：总管理员手机号
ERP_BOOTSTRAP_ADMIN_PHONE=
ERP_DB=/var/lib/erp/erp.db
ERP_UPLOAD_DIR=/var/lib/erp/uploads
ERP_HOST=127.0.0.1
ERP_PORT=8787
ERP_TRUST_PROXY=0
ERP_SECRET=
# 正式短信验证码：腾讯云短信 SMS。绝不可提交密钥。
ERP_SMS_PROVIDER=tencent
ERP_TENCENT_SECRET_ID=
ERP_TENCENT_SECRET_KEY=
ERP_TENCENT_SMS_APP_ID=
ERP_TENCENT_SMS_SIGN=
ERP_TENCENT_SMS_TEMPLATE_ID=
ERP_TENCENT_SMS_REGION=ap-guangzhou
# 仅自动化测试：NODE_ENV=test ERP_SMS_PROVIDER=test ERP_SMS_TEST_MODE=1
