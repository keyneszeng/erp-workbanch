{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "erp-workbanch",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-08-04",
  "assets": {
    "directory": "./web",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ERP_DB",
        "class_name": "ErpDatabase"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ErpDatabase"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
