{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "erp-workbanch",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-08-04",
  "routes": [
    {
      "pattern": "erp.aibuild.work",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./web",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ERP_DB",
        "class_name": "ErpDatabase"
      }
    ]
  },
  // 材料附件（照片 / PDF）存 R2。
  // 首次部署前必须先建桶：wrangler r2 bucket create erp-workbanch-files
  // 若暂时不建桶，把下面这段删掉即可部署，上传接口会返回 503，其余功能不受影响。
  "r2_buckets": [
    {
      "binding": "ERP_FILES",
      "bucket_name": "erp-workbanch-files"
    }
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ErpDatabase"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
